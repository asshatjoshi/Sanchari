// HiveMQ Cloud: host = xxxx.s1.eu.hivemq.cloud, port 8883, TLS 1.
#define MQTT_HOST "192.168.1.10"
#define MQTT_PORT 1883
#define MQTT_USE_TLS 0
#define MQTT_USER ""
#define MQTT_PASS ""

