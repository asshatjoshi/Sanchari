# Copy to .env (git-ignored). `npm start` loads it automatically.
PORT=3000
DB_PATH=data/sanchari.db
MQTT_URL=mqtt://localhost:1883
# For HiveMQ Cloud: MQTT_URL=mqtts://xxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=
# Long random string; needed to use /admin. e.g. `openssl rand -hex 24`
ADMIN_TOKEN=
# Public base URL printed into QR codes, e.g. https://sanchari.example.com
PUBLIC_URL=
