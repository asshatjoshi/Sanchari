    "mqtt": "^5.16.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
